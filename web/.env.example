# Copy to .env.local (ignored by git) and adjust.

# Base URL of the FastAPI backend, without /v1 and without a trailing slash. The Next.js server proxies
# /api/:path* to BACKEND_URL/:path* (src/proxy.ts), so the browser only talks to the web app's own origin.
# Read at runtime by the server (`next dev`, `next start`, `node server.js` of the standalone build), not by `next build`:
# set it on the container that runs the production image (e.g. BACKEND_URL=http://backend:5000 in docker-compose.prod.yml).
#   - local backend started with `docker compose up -d db flyway backend`: http://localhost:5000
#   - web container in the same compose network: http://backend:5000
#   - production: the internal URL of the backend service
BACKEND_URL=http://localhost:5000

# How many reverse proxies in front of the web server append the client's address to X-Forwarded-For and are trusted
# (default 0). Only the last TRUSTED_PROXY_HOPS entries are forwarded to the backend, which uses them for its rate
# limits and the login IP. With 0 no X-Forwarded-For is sent (a client could write any). The web port must only be
# reachable through these proxies. Production (Cloudflare and Traefik) uses 2, set in docker-compose.prod.yml together
# with the backend's FORWARDED_ALLOW_IPS.
TRUSTED_PROXY_HOPS=0
