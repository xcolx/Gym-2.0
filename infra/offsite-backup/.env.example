# Copy to .env next to the Dockerfile and fill in every value, see README.md.

# Name of the login and of the repository, which is served at /<REPO_USER>/ on both endpoints
REPO_USER=gym2

# Login of the append-only endpoint (:8000), used by the backed up host. Generate with: openssl rand -hex 32
APPEND_ONLY_PASSWORD=

# Login of the full-access endpoint (:8001), only used from the admin machine to remove old snapshots. Must differ from
# APPEND_ONLY_PASSWORD and never be stored on the backed up host. Generate with: openssl rand -hex 32
FULL_ACCESS_PASSWORD=
