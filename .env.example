# Copy to .env next to docker-compose.prod.yml on the production host and fill in every value.
# All other settings (domains, ports, URLs) are fixed in docker-compose.prod.yml.

# Database password. Generate with: openssl rand -hex 32
# (hex only, since it's also put into the database URL)
POSTGRES_PASSWORD=

# Key used to derive the email verification tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# Login of the mailbox on the Stalwart mail server (mail.colinrueegg.com) the account emails are sent from,
# EMAIL_USER is also the sender address
EMAIL_USER=
EMAIL_PASS=

# API versions the apps should move away from, as JSON lists, e.g. ["v1"]. Apply with: docker compose -f docker-compose.prod.yml up -d backend
# Deprecated: still works, the app shows an update notice the user can dismiss (at most once a day)
DEPRECATED_API_VERSIONS=[]
# Retired: every request gets 410, the app only shows the update screen. Keep it after the routes are removed.
RETIRED_API_VERSIONS=[]

# Offsite backup (see infra/README.md, Backups). The restic repository on a rest-server in append-only mode,
# e.g. rest:https://backup.example.org/gym2/ (with --private-repos the path must match the user name)
RESTIC_REPOSITORY=
# Login of the rest-server. It can only add backups, not delete them.
RESTIC_REST_USERNAME=gym2
RESTIC_REST_PASSWORD=
# Encrypts the backups, the offsite ones and the local dumps in /data/backups. Generate with: openssl rand -hex 32
# Also store it outside this host (e.g. a password manager), without it the backups can't be restored.
RESTIC_PASSWORD=
# Ping URL of a healthchecks.io check (period 1 day, grace 2 hours), alerts when a nightly backup fails or doesn't run
BACKUP_HEALTHCHECK_URL=
